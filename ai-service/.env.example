# ComplyGeM AI Service Environment Configuration

# PostgreSQL 18 Relational Database (SQLAlchemy 2.x + Psycopg 3)
DATABASE_URL=postgresql+psycopg://complygem_app:your_strong_password@localhost:5432/complygem
SQL_ECHO=false

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004

# Firebase Configuration
FIREBASE_PROJECT_ID=complygem-sih2026
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Operational Mode (Set to false in production)
DEMO_MODE=true

# FAISS Vector Storage Path
FAISS_INDEX_PATH=./data/faiss_index
