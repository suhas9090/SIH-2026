{
  "name": "complygem-backend",
  "version": "1.0.0",
  "description": "ComplyGeM AI - Backend API Server",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:start": "node src/db-server.js",
    "db:push": "prisma db push --schema=src/prisma/schema.prisma",
    "seed": "node src/prisma/seed.js",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.7.0",
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.14.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.0"
  }
}
